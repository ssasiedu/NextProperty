<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_next_owner_billing_generate" model="ir.cron">
            <field name="name">NEXT Owner Billing: Generate Due Monthly Bills</field>
            <field name="model_id" ref="model_next_owner_service_charge"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_bills()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_next_owner_billing_reminders" model="ir.cron">
            <field name="name">NEXT Owner Billing: Defaulter Reminders</field>
            <field name="model_id" ref="model_next_owner_bill"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_defaulter_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
