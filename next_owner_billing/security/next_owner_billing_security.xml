<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_next_owner_bill_owner_read" model="ir.rule">
            <field name="name">Property Owner: own issued bills only, read-only</field>
            <field name="model_id" ref="model_next_owner_bill"/>
            <field name="domain_force">[('owner_id.user_ids', 'in', [user.id]), ('state', '=', 'issued')]</field>
            <field name="groups" eval="[(4, ref('next_base.group_next_property_owner'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_next_owner_bill_accountant" model="ir.rule">
            <field name="name">Accountant/Manager: full access to owner bills</field>
            <field name="model_id" ref="model_next_owner_bill"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('next_base.group_next_accountant')), (4, ref('next_base.group_next_manager'))]"/>
        </record>

        <record id="rule_next_owner_bill_payment_owner_read" model="ir.rule">
            <field name="name">Property Owner: own bill payments only, read-only</field>
            <field name="model_id" ref="model_next_owner_bill_payment"/>
            <field name="domain_force">[('owner_id.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('next_base.group_next_property_owner'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_next_owner_bill_payment_accountant" model="ir.rule">
            <field name="name">Accountant/Manager: full access to bill payments</field>
            <field name="model_id" ref="model_next_owner_bill_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('next_base.group_next_accountant')), (4, ref('next_base.group_next_manager'))]"/>
        </record>

    </data>
</odoo>
