<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_owner_bill_form" model="ir.ui.view">
        <field name="name">next.owner.bill.form</field>
        <field name="model">next.owner.bill</field>
        <field name="arch" type="xml">
            <form string="Owner Service Charge Bill">
                <header>
                    <button name="action_issue" string="Issue" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="owner_id"/>
                            <field name="property_id"/>
                            <field name="service_charge_id"/>
                        </group>
                        <group>
                            <field name="period_month"/>
                            <field name="period_year"/>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="amount"/>
                            <field name="amount_paid"/>
                            <field name="balance"/>
                        </group>
                        <group>
                            <field name="payment_state" widget="badge"/>
                            <field name="has_pending_report"/>
                            <field name="is_defaulter"/>
                            <field name="reminder_count"/>
                            <field name="last_reminder_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payment_ids">
                                <list editable="bottom" decoration-muted="state == 'reported'">
                                    <field name="payment_date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="reference"/>
                                    <field name="state"/>
                                    <field name="confirmed_by" readonly="1"/>
                                    <button name="action_confirm" string="Confirm" type="object"
                                            invisible="state == 'confirmed'" class="btn-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_next_owner_bill_list" model="ir.ui.view">
        <field name="name">next.owner.bill.list</field>
        <field name="model">next.owner.bill</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_defaulter" decoration-success="payment_state == 'paid'">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="property_id"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <field name="due_date"/>
                <field name="amount" sum="Total"/>
                <field name="balance" sum="Outstanding"/>
                <field name="payment_state"/>
                <field name="has_pending_report" optional="show"/>
                <field name="is_defaulter" optional="show"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_next_owner_bill_kanban" model="ir.ui.view">
        <field name="name">next.owner.bill.kanban</field>
        <field name="model">next.owner.bill</field>
        <field name="arch" type="xml">
            <kanban default_group_by="payment_state">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="property_id"/>
                <field name="balance"/>
                <field name="is_defaulter"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <strong><field name="name"/></strong>
                            <div><field name="owner_id"/> &#8212; <field name="property_id"/></div>
                            <div>Balance: <field name="balance"/></div>
                            <span t-if="record.is_defaulter.raw_value" class="badge text-bg-danger">Overdue</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_next_owner_bill_search" model="ir.ui.view">
        <field name="name">next.owner.bill.search</field>
        <field name="model">next.owner.bill</field>
        <field name="arch" type="xml">
            <search>
                <field name="owner_id"/>
                <field name="property_id"/>
                <filter string="Defaulters" name="defaulters" domain="[('is_defaulter', '=', True)]"/>
                <filter string="Awaiting Confirmation" name="pending_report" domain="[('has_pending_report', '=', True)]"/>
                <filter string="Paid" name="paid" domain="[('payment_state', '=', 'paid')]"/>
                <filter string="Unpaid/Partial" name="unpaid" domain="[('payment_state', '!=', 'paid')]"/>
                <separator/>
                <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                <filter string="Payment Status" name="group_payment_state" context="{'group_by': 'payment_state'}"/>
                <filter string="Period" name="group_period" context="{'group_by': 'period_month'}"/>
            </search>
        </field>
    </record>

    <!-- Director/Management Billing Dashboard - "a nice dashboard...
         where the director would be able to see the schedule and the
         defaulters and those that paid for a specific month." -->
    <record id="action_next_owner_bill_dashboard" model="ir.actions.act_window">
        <field name="name">Owner Billing Dashboard</field>
        <field name="res_model">next.owner.bill</field>
        <field name="view_mode">kanban,list,pivot,form</field>
        <field name="domain">[('state', '=', 'issued')]</field>
        <field name="context">{'search_default_group_period': 1}</field>
    </record>

    <record id="view_next_owner_bill_pivot" model="ir.ui.view">
        <field name="name">next.owner.bill.pivot</field>
        <field name="model">next.owner.bill</field>
        <field name="arch" type="xml">
            <pivot string="Owner Billing">
                <field name="property_id" type="row"/>
                <field name="period_month" type="col"/>
                <field name="amount" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_next_owner_bill" model="ir.actions.act_window">
        <field name="name">Owner Bills</field>
        <field name="res_model">next.owner.bill</field>
        <field name="view_mode">list,kanban,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bills yet</p>
            <p>Raised automatically from a Service Charge, or create one directly for a one-off charge.</p>
        </field>
    </record>

</odoo>
