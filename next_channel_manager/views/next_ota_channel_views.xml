<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_ota_channel_form" model="ir.ui.view">
        <field name="name">next.ota.channel.form</field>
        <field name="model">next.ota.channel</field>
        <field name="arch" type="xml">
            <form string="OTA Channel">
                <header>
                    <button name="action_sync_now" string="Sync Now" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="channel_type"/>
                            <field name="property_id"/>
                            <field name="external_listing_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="api_key"/>
                            <field name="api_secret" password="True"/>
                            <field name="sync_rates"/>
                            <field name="sync_availability"/>
                            <field name="last_sync_date" readonly="1"/>
                            <field name="last_sync_status" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_next_ota_channel_list" model="ir.ui.view">
        <field name="name">next.ota.channel.list</field>
        <field name="model">next.ota.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="property_id"/>
                <field name="last_sync_date"/>
                <field name="last_sync_status"/>
            </list>
        </field>
    </record>

    <record id="action_next_ota_channel" model="ir.actions.act_window">
        <field name="name">OTA Channels</field>
        <field name="res_model">next.ota.channel</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
