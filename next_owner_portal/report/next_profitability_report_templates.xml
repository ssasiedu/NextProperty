<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_next_profitability">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 style="margin-bottom:2px;">Property Profitability Report</h2>
                <p class="text-muted">Period: <t t-esc="period_month"/>/<t t-esc="period_year"/>
                   &#8212; internal/management only; never shown to a Property Owner.</p>

                <t t-set="breakdowns" t-value="[d._get_profitability_breakdown(period_month, period_year) for d in docs]"/>
                <t t-set="breakdowns" t-value="sorted(breakdowns, key=lambda b: b['net_income'], reverse=True)"/>

                <h4>Ranked by Net Income</h4>
                <table class="table table-sm mb-4">
                    <thead><tr><th>Rank</th><th>Property</th><th class="text-end">Revenue</th>
                        <th class="text-end">Expenses</th><th class="text-end">Net Income</th></tr></thead>
                    <tbody>
                        <t t-foreach="breakdowns" t-as="b">
                            <tr>
                                <td><t t-esc="breakdowns.index(b) + 1"/></td>
                                <td><t t-esc="b['property'].name"/></td>
                                <td class="text-end"><span t-esc="b['revenue']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td class="text-end"><span t-esc="b['expenses']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td class="text-end" t-attf-style="font-weight:600;color:#{'#027A48' if b['net_income'] >= 0 else '#B42318'};">
                                    <span t-esc="b['net_income']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <t t-foreach="breakdowns" t-as="b">
                    <h4><t t-esc="b['property'].name"/> &#8212; Room Breakdown</h4>
                    <table class="table table-sm mb-4">
                        <thead><tr><th>Room</th><th class="text-end">Revenue</th>
                            <th class="text-end">Expenses</th><th class="text-end">Net Income</th></tr></thead>
                        <tbody>
                            <tr t-if="not b['rooms']"><td colspan="4" class="text-muted">No rooms on this property.</td></tr>
                            <tr t-foreach="sorted(b['rooms'], key=lambda r: r['net_income'], reverse=True)" t-as="r">
                                <td><t t-esc="r['room'].name"/></td>
                                <td class="text-end"><span t-esc="r['revenue']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td class="text-end"><span t-esc="r['expenses']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                <td class="text-end"><span t-esc="r['net_income']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <p class="text-muted mt-2">
                    Room revenue/expenses are computed the same way as the Owner Settlement Statement
                    (next.room.compute_internal_net_income) - never the manually published Owner Net
                    Revenue figure shown to owners.
                </p>
            </div>
        </t>
    </t>
</template>
</odoo>
