<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_room_expense_list" model="ir.ui.view">
        <field name="name">next.room.expense.list</field>
        <field name="model">next.room.expense</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="property_id"/>
                <field name="room_id"/>
                <field name="category"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <field name="amount"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_next_room_expense" model="ir.actions.act_window">
        <field name="name">Room/Property Expenses</field>
        <field name="res_model">next.room.expense</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
