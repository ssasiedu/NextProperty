<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_property_viewing_form" model="ir.ui.view">
        <field name="name">next.property.viewing.form</field>
        <field name="model">next.property.viewing</field>
        <field name="arch" type="xml">
            <form string="Property Viewing">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'requested'"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,confirmed,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="room_id"/>
                            <field name="owner_id"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="assigned_manager_id"/>
                            <field name="requires_room_block"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_next_property_viewing_list" model="ir.ui.view">
        <field name="name">next.property.viewing.list</field>
        <field name="model">next.property.viewing</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="owner_id"/>
                <field name="date_start"/>
                <field name="purpose"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_next_property_viewing_calendar" model="ir.ui.view">
        <field name="name">next.property.viewing.calendar</field>
        <field name="model">next.property.viewing</field>
        <field name="arch" type="xml">
            <calendar date_start="date_start" date_stop="date_end" string="Property Viewings" color="property_id">
                <field name="owner_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_next_property_viewing" model="ir.actions.act_window">
        <field name="name">Property Viewings</field>
        <field name="res_model">next.property.viewing</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

</odoo>
