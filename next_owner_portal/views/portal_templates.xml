<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- /my on its own never linked here - an owner who logged in had no way to
     find /my/owner short of being told the URL directly. config_card shows
     the card immediately (no count badge needed for a plain navigation link). -->
<template id="portal_my_home_owner_inherit" inherit_id="portal.portal_my_home" name="Portal Home: My Properties">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
        <t t-if="request.env.user.has_group('next_base.group_next_property_owner')" t-call="portal.portal_docs_entry">
            <t t-set="title">My Properties</t>
            <t t-set="text">Net revenue, room status and viewings for your properties</t>
            <t t-set="url" t-value="'/my/owner'"/>
            <t t-set="config_card" t-value="True"/>
        </t>
    </xpath>
</template>

<template id="owner_portal_home" name="Owner Portal Home">
    <t t-call="portal.portal_layout">
        <h2>My Properties</h2>
        <div class="row">
            <t t-foreach="properties" t-as="prop">
                <div class="col-md-4 mb-3">
                    <div class="card p-3">
                        <h4><t t-esc="prop.name"/></h4>
                        <a href="/my/owner/net-revenue" class="btn btn-link">Net Revenue</a>
                        <a href="/my/owner/rooms" class="btn btn-link">Room Status</a>
                        <a href="/my/owner/viewings" class="btn btn-link">Viewings</a>
                    </div>
                </div>
            </t>
        </div>
    </t>
</template>

<template id="owner_portal_net_revenue" name="Owner Portal - Net Revenue">
    <t t-call="portal.portal_layout">
        <h2>Net Revenue Statements</h2>
        <p class="text-muted">Figures below are the officially published statements for your properties.</p>

        <div t-if="trend_chart" class="card p-3 p-md-4 mb-4 next-trend-card">
            <h5 class="mb-3">Net Revenue Trend</h5>
            <!-- Every coordinate is computed server-side (_build_trend_chart
                 in owner_portal.py) - the template only renders values, it
                 never calculates with them. currentColor on the line/fill
                 picks up next-trend-card's own text-primary color below,
                 which is the normal way to theme inline SVG from CSS
                 without inlining a fixed hex that could drift from the
                 site's actual primary color. -->
            <svg t-attf-viewBox="0 0 #{trend_chart['width']} #{trend_chart['height']}"
                 class="w-100 text-primary" preserveAspectRatio="none"
                 style="height: 220px; display: block; overflow: visible;">
                <defs>
                    <linearGradient id="nextTrendFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="currentColor" stop-opacity="0.28"/>
                        <stop offset="100%" stop-color="currentColor" stop-opacity="0.02"/>
                    </linearGradient>
                </defs>
                <t t-foreach="trend_chart['gridlines_y']" t-as="gy">
                    <line x1="0" t-att-y1="gy" t-attf-x2="#{trend_chart['width']}" t-att-y2="gy"
                          stroke="#E5E7EB" stroke-width="1"/>
                </t>
                <polygon t-attf-points="#{trend_chart['area_points']}" fill="url(#nextTrendFill)"/>
                <polyline t-attf-points="#{trend_chart['line_points']}" fill="none" stroke="currentColor"
                          stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
                <t t-foreach="trend_chart['points']" t-as="pt">
                    <circle t-att-cx="pt['x']" t-att-cy="pt['y']" r="4.5" fill="white"
                            stroke="currentColor" stroke-width="2.5">
                        <title><t t-esc="pt['label']"/>: <t t-esc="pt['amount_label']"/></title>
                    </circle>
                    <text t-att-x="pt['x']" t-attf-y="#{pt['y'] - 12}" text-anchor="middle"
                          font-size="12" font-weight="600" fill="#1F2937">
                        <t t-esc="pt['amount_label']"/>
                    </text>
                    <text t-att-x="pt['x']" t-attf-y="#{trend_chart['height'] - 8}" text-anchor="middle"
                          font-size="11" fill="#6B7280">
                        <t t-esc="pt['label']"/>
                    </text>
                </t>
            </svg>
        </div>

        <table class="table">
            <thead><tr><th>Property</th><th>Room</th><th>Period</th><th>Amount</th><th>Payment</th><th/></tr></thead>
            <tbody>
                <tr t-foreach="statements" t-as="st">
                    <td><t t-esc="st.property_id.name"/></td>
                    <td><t t-esc="st.room_id.name or '-'"/></td>
                    <td><t t-esc="st.period_month"/>/<t t-esc="st.period_year"/></td>
                    <td><span t-field="st.amount"/></td>
                    <td>
                        <span t-if="st.payment_state == 'unpaid'" class="badge text-bg-secondary">Unpaid</span>
                        <span t-if="st.payment_state == 'paid'" class="badge text-bg-warning">Paid - please confirm</span>
                        <span t-if="st.payment_state == 'confirmed'" class="badge text-bg-success">Confirmed</span>
                    </td>
                    <td>
                        <form t-if="st.payment_state == 'paid'" t-attf-action="/my/owner/net-revenue/#{st.id}/confirm" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn btn-sm btn-primary">Confirm Receipt</button>
                        </form>
                    </td>
                </tr>
            </tbody>
        </table>
    </t>
</template>

<template id="owner_portal_rooms" name="Owner Portal - Room Status">
    <t t-call="portal.portal_layout">
        <h2>My Rooms - Live Status</h2>
        <div class="row">
            <t t-foreach="rooms" t-as="room">
                <div class="col-md-3 mb-3">
                    <div class="card p-2 text-center" t-attf-style="border-left: 6px solid #{room.status_color};">
                        <strong><t t-esc="room.name"/></strong>
                        <div><t t-esc="dict(room._fields['status'].selection).get(room.status)"/></div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</template>

<template id="owner_portal_viewings" name="Owner Portal - Property Viewings">
    <t t-call="portal.portal_layout">
        <h2>Property Viewings</h2>
        <table class="table mb-4">
            <thead><tr><th>Property</th><th>Date</th><th>Purpose</th><th>Status</th></tr></thead>
            <tbody>
                <tr t-foreach="viewings" t-as="v">
                    <td><t t-esc="v.property_id.name"/></td>
                    <td><t t-esc="v.date_start"/></td>
                    <td><t t-esc="v.purpose"/></td>
                    <td><t t-esc="v.state"/></td>
                </tr>
            </tbody>
        </table>
        <h4>Request a New Viewing</h4>
        <form action="/my/owner/viewings/new" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <div class="mb-3">
                <label>Property</label>
                <select name="property_id" class="form-select">
                    <option t-foreach="properties" t-as="p" t-att-value="p.id"><t t-esc="p.name"/></option>
                </select>
            </div>
            <div class="mb-3">
                <label>Purpose</label>
                <select name="purpose" class="form-select">
                    <option value="routine_inspection">Routine Inspection</option>
                    <option value="investment_review">Investment Review</option>
                    <option value="handover">Handover</option>
                </select>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Start</label>
                    <input type="datetime-local" name="date_start" class="form-control" required="required"/>
                </div>
                <div class="col-md-6">
                    <label>End</label>
                    <input type="datetime-local" name="date_end" class="form-control" required="required"/>
                </div>
            </div>
            <div class="mb-3">
                <label>Notes</label>
                <textarea name="notes" class="form-control"/>
            </div>
            <button type="submit" class="btn btn-primary">Request Viewing</button>
        </form>
    </t>
</template>

</odoo>
