<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_owner_net_revenue_form" model="ir.ui.view">
        <field name="name">next.owner.net.revenue.form</field>
        <field name="model">next.owner.net.revenue</field>
        <field name="arch" type="xml">
            <form string="Owner Net Revenue Statement">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="btn-primary" invisible="state != 'draft' or supersedes_id"/>
                    <button name="action_publish_revision" string="Publish Revision" type="object"
                            class="btn-primary" invisible="state != 'draft' or not supersedes_id"/>
                    <button name="action_create_revision" string="Create Revision" type="object"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,superseded"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="room_id"/>
                            <field name="period_month"/>
                            <field name="period_year"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="entered_by" readonly="1"/>
                            <field name="date_entered" readonly="1"/>
                            <field name="supersedes_id" readonly="1" invisible="not supersedes_id"/>
                            <field name="revision_number" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes"/>
                    <field name="attachment" filename="attachment_filename"/>
                    <field name="attachment_filename" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_next_owner_net_revenue_list" model="ir.ui.view">
        <field name="name">next.owner.net.revenue.list</field>
        <field name="model">next.owner.net.revenue</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='published'" decoration-muted="state=='superseded'">
                <field name="property_id"/>
                <field name="room_id"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_next_owner_net_revenue" model="ir.actions.act_window">
        <field name="name">Owner Net Revenue Statements</field>
        <field name="res_model">next.owner.net.revenue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
