<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_next_housekeeping_routine" model="ir.cron">
            <field name="name">NEXT Housekeeping: Create Routine Servicing Tasks</field>
            <field name="model_id" ref="model_next_housekeeping_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_routine_tasks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_next_housekeeping_overdue" model="ir.cron">
            <field name="name">NEXT Housekeeping: Flag Overdue Tasks</field>
            <field name="model_id" ref="model_next_housekeeping_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_overdue_tasks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
