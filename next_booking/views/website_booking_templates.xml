<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="booking_step_property" name="Booking - Select Property">
    <t t-call="website.layout">
        <div class="container py-5 next-book-property">
            <div class="mb-4">
                <h1 class="mb-1">Select a Property</h1>
                <p class="text-muted mb-0">Choose where you'd like to stay to see available rooms and rates.</p>
            </div>
            <div class="row g-4">
                <t t-foreach="properties" t-as="prop">
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 next-book-card">
                            <!-- bg-primary/text-primary (Bootstrap utilities) rather than a
                                 hardcoded hex, so this picks up the site's own theme color
                                 instead of one that could clash with it or drift from it. -->
                            <div class="next-book-card-banner bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-between px-3">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3 21V9l9-6 9 6v12" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                                    <path d="M9 21v-7h6v7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                                </svg>
                                <span t-if="prop.room_type_ids" class="next-book-card-badge bg-white bg-opacity-75 text-primary">
                                    <t t-esc="len(prop.room_type_ids)"/> room type<t t-if="len(prop.room_type_ids) != 1">s</t>
                                </span>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h4 class="card-title mb-1"><t t-esc="prop.name"/></h4>
                                <p class="text-muted small mb-3 flex-grow-1">
                                    <t t-if="prop.city or prop.country_id">
                                        <t t-esc="prop.city"/><t t-if="prop.city and prop.country_id">, </t><t t-esc="prop.country_id.name"/>
                                    </t>
                                    <t t-else="">&#160;</t>
                                </p>
                                <a t-attf-href="/book/dates?property_id=#{prop.id}" class="btn btn-primary">Select</a>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>

        <style>
            .next-book-card {
                border: 1px solid #E5E7EB;
                border-radius: 14px;
                overflow: hidden;
                transition: box-shadow .15s ease, transform .15s ease;
            }
            .next-book-card:hover {
                box-shadow: 0 10px 28px rgba(0, 0, 0, .1);
                transform: translateY(-2px);
            }
            .next-book-card-banner { height: 92px; }
            .next-book-card-badge {
                font-size: .75rem;
                font-weight: 600;
                padding: 3px 11px;
                border-radius: 999px;
            }
        </style>
    </t>
</template>

<template id="booking_step_dates" name="Booking - Select Dates">
    <t t-call="website.layout">
        <div class="container py-5">
            <h1>Select Your Dates</h1>
            <form action="/book/occupancy" method="get" class="row g-3">
                <input type="hidden" name="property_id" t-att-value="property_id"/>
                <div class="col-md-4">
                    <label>Check-in</label>
                    <input type="date" name="date_from" class="form-control" required="required"/>
                </div>
                <div class="col-md-4">
                    <label>Check-out</label>
                    <input type="date" name="date_to" class="form-control" required="required"/>
                </div>
                <div class="col-md-4 align-self-end">
                    <button type="submit" class="btn btn-primary">Next</button>
                </div>
            </form>
        </div>
    </t>
</template>

<template id="booking_step_occupancy" name="Booking - Occupancy">
    <t t-call="website.layout">
        <div class="container py-5">
            <h1>Who's Staying?</h1>
            <form action="/book/availability" method="get" class="row g-3">
                <input type="hidden" name="property_id" t-att-value="property_id"/>
                <input type="hidden" name="date_from" t-att-value="date_from"/>
                <input type="hidden" name="date_to" t-att-value="date_to"/>
                <div class="col-md-3">
                    <label>Adults</label>
                    <input type="number" name="adults" min="1" value="2" class="form-control"/>
                </div>
                <div class="col-md-3">
                    <label>Children</label>
                    <input type="number" name="children" min="0" value="0" class="form-control"/>
                </div>
                <div class="col-md-3">
                    <label>Rooms</label>
                    <input type="number" name="rooms" min="1" value="1" class="form-control"/>
                </div>
                <div class="col-md-3 align-self-end">
                    <button type="submit" class="btn btn-primary">Search Availability</button>
                </div>
            </form>
        </div>
    </t>
</template>

<template id="booking_step_availability" name="Booking - Availability Results">
    <t t-call="website.layout">
        <div class="container py-5">
            <h1>Available Rooms</h1>
            <div t-if="not results" class="alert alert-warning">No rooms available for these dates/occupancy.</div>
            <div class="row">
                <t t-foreach="results" t-as="r">
                    <div class="col-md-4 mb-3">
                        <div class="card p-3">
                            <img t-if="r['room_type'].image_1920" t-attf-src="/web/image/next.room.type/#{r['room_type'].id}/image_1920" class="img-fluid mb-2"/>
                            <h4><t t-esc="r['room_type'].name"/></h4>
                            <p t-field="r['room_type'].description"/>
                            <p><strong>Total: <t t-esc="r['price']"/></strong></p>
                            <a t-attf-href="/book/select/#{r['room_type'].id}?property_id=#{property_id}&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;adults=#{adults}&amp;children=#{children}&amp;rooms=#{rooms}"
                               class="btn btn-primary">Select</a>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</template>

<template id="booking_step_confirm" name="Booking - Confirm &amp; Pay">
    <t t-call="website.layout">
        <div class="container py-5">
            <h1>Confirm Your Booking</h1>
            <p><t t-esc="room_type.name"/> &#8212; <t t-esc="date_from"/> to <t t-esc="date_to"/></p>
            <p>Total: <strong><t t-esc="price"/></strong></p>
            <div t-if="error" class="alert alert-danger"><t t-esc="error"/></div>
            <form action="/book/confirm" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="room_type_id" t-att-value="room_type.id"/>
                <input type="hidden" name="property_id" t-att-value="property_id"/>
                <input type="hidden" name="date_from" t-att-value="date_from"/>
                <input type="hidden" name="date_to" t-att-value="date_to"/>
                <input type="hidden" name="adults" t-att-value="adults"/>
                <input type="hidden" name="children" t-att-value="children"/>
                <input type="hidden" name="rooms" t-att-value="rooms"/>
                <!-- A public/anonymous booker has no partner record of their
                     own yet - without these, front desk had a confirmed
                     booking with literally no name, email or phone to follow
                     up on. A logged-in guest already has a real partner_id,
                     so this section doesn't show at all. -->
                <div t-if="is_public" class="row g-3 mb-3">
                    <h5 class="mt-2">Your Details</h5>
                    <div class="col-md-4">
                        <label>Full Name</label>
                        <input type="text" name="guest_name" class="form-control" required="required"
                               t-att-value="guest_name or ''"/>
                    </div>
                    <div class="col-md-4">
                        <label>Email</label>
                        <input type="email" name="guest_email" class="form-control" required="required"
                               t-att-value="guest_email or ''"/>
                    </div>
                    <div class="col-md-4">
                        <label>Phone</label>
                        <input type="tel" name="guest_phone" class="form-control"
                               t-att-value="guest_phone or ''"/>
                    </div>
                </div>
                <button type="submit" class="btn btn-success btn-lg">Confirm &amp; Pay</button>
            </form>
        </div>
    </t>
</template>
</odoo>
