<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_next_sms_dispatch_queue" model="ir.cron">
            <field name="name">NEXT SMS: Dispatch Queued Messages (queue_job fallback)</field>
            <field name="model_id" ref="model_next_sms_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_dispatch_queued()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_next_sms_checkin_reminders" model="ir.cron">
            <field name="name">NEXT SMS: Send 24h Check-in Reminders</field>
            <field name="model_id" ref="next_base.model_next_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_checkin_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
