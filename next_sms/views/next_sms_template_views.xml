<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_sms_template_form" model="ir.ui.view">
        <field name="name">next.sms.template.form</field>
        <field name="model">next.sms.template</field>
        <field name="arch" type="xml">
            <form string="SMS Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="trigger_code"/>
                        <field name="property_id"/>
                        <field name="active"/>
                    </group>
                    <field name="body" placeholder="Use {guest_name}, {room_number}, {date_from}, {date_to}, {amount}..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_next_sms_template_list" model="ir.ui.view">
        <field name="name">next.sms.template.list</field>
        <field name="model">next.sms.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="trigger_code"/>
                <field name="property_id"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_next_sms_template" model="ir.actions.act_window">
        <field name="name">SMS Templates</field>
        <field name="res_model">next.sms.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
