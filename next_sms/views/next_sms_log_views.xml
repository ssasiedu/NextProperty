<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_sms_log_list" model="ir.ui.view">
        <field name="name">next.sms.log.list</field>
        <field name="model">next.sms.log</field>
        <field name="arch" type="xml">
            <list decoration-success="status=='delivered'" decoration-danger="status=='failed'"
                  decoration-muted="status=='queued'" create="false">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="to_number"/>
                <field name="trigger_code"/>
                <field name="property_id"/>
                <field name="status"/>
                <field name="cost" sum="Total Cost"/>
            </list>
        </field>
    </record>

    <record id="view_next_sms_log_form" model="ir.ui.view">
        <field name="name">next.sms.log.form</field>
        <field name="model">next.sms.log</field>
        <field name="arch" type="xml">
            <form string="SMS Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="to_number"/>
                            <field name="trigger_code"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="provider_message_id"/>
                            <field name="error_message" invisible="status != 'failed'"/>
                            <field name="cost"/>
                            <field name="sent_date"/>
                            <field name="delivered_date"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_next_sms_log" model="ir.actions.act_window">
        <field name="name">SMS Log</field>
        <field name="res_model">next.sms.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
