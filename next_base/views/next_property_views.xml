<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_property_form" model="ir.ui.view">
        <field name="name">next.property.form</field>
        <field name="model">next.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Property name"/></h1>
                    </div>
                    <group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Settings">
                            <field name="code"/>
                            <field name="tz"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="manager_id"/>
                        </group>
                    </group>
                    <group string="Owners">
                        <field name="owner_ids" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Room Types">
                            <field name="room_type_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                    <field name="max_adults"/>
                                    <field name="max_children"/>
                                    <field name="room_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rooms">
                            <field name="room_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="room_type_id"/>
                                    <field name="status"/>
                                    <field name="owner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_next_property_list" model="ir.ui.view">
        <field name="name">next.property.list</field>
        <field name="model">next.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="city"/>
                <field name="room_count"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <record id="action_next_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">next.property</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
