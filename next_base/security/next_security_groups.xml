<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_next" model="ir.module.category">
            <field name="name">NEXT Property Management</field>
            <field name="sequence">20</field>
        </record>

        <!-- Odoo 19 removed res.groups.category_id: the Users form now groups
             groups into sections via res.groups.privilege (category_id lives
             there instead). One privilege per independent role gives each a
             its own row under the "NEXT Property Management" section;
             Housekeeping Staff/Supervisor share a privilege so they render as
             a single two-level dropdown. -->

        <record id="privilege_next_front_desk" model="res.groups.privilege">
            <field name="name">Front Desk</field>
            <field name="category_id" ref="module_category_next"/>
        </record>
        <record id="privilege_next_housekeeping" model="res.groups.privilege">
            <field name="name">Housekeeping</field>
            <field name="category_id" ref="module_category_next"/>
        </record>
        <record id="privilege_next_maintenance" model="res.groups.privilege">
            <field name="name">Maintenance</field>
            <field name="category_id" ref="module_category_next"/>
        </record>
        <record id="privilege_next_owner" model="res.groups.privilege">
            <field name="name">Owner</field>
            <field name="category_id" ref="module_category_next"/>
        </record>
        <record id="privilege_next_accountant" model="res.groups.privilege">
            <field name="name">Accounting</field>
            <field name="category_id" ref="module_category_next"/>
        </record>
        <record id="privilege_next_manager" model="res.groups.privilege">
            <field name="name">Management</field>
            <field name="category_id" ref="module_category_next"/>
        </record>

        <!-- Guest (portal) reuses base.group_portal; no custom group needed. -->

        <record id="group_next_front_desk" model="res.groups">
            <field name="name">Front Desk Staff</field>
            <field name="privilege_id" ref="privilege_next_front_desk"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Housekeeping Staff and Maintenance Officer are deliberately
             PORTAL-tier, not full internal users: these are typically the
             largest headcount in the suite, and a worker only ever needs
             the lightweight "my tasks" self-service page each module's
             worker portal provides (see next_housekeeping/next_maintenance),
             never the backend. This also means they don't consume an
             internal-user seat. The Supervisor/Officer-with-backend-access
             tier below adds base.group_user back on top for anyone who
             genuinely needs the full Kanban/list backend views. -->
        <record id="group_next_housekeeping" model="res.groups">
            <field name="name">Housekeeping Staff</field>
            <field name="privilege_id" ref="privilege_next_housekeeping"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_next_housekeeping_supervisor" model="res.groups">
            <field name="name">Housekeeping Supervisor</field>
            <field name="privilege_id" ref="privilege_next_housekeeping"/>
            <field name="implied_ids" eval="[(4, ref('group_next_housekeeping')), (4, ref('base.group_user'))]"/>
        </record>

        <record id="group_next_maintenance_officer" model="res.groups">
            <field name="name">Maintenance Officer</field>
            <field name="privilege_id" ref="privilege_next_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_next_maintenance_supervisor" model="res.groups">
            <field name="name">Maintenance Supervisor</field>
            <field name="privilege_id" ref="privilege_next_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('group_next_maintenance_officer')), (4, ref('base.group_user'))]"/>
        </record>

        <record id="group_next_property_owner" model="res.groups">
            <field name="name">Property Owner</field>
            <field name="privilege_id" ref="privilege_next_owner"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_next_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="privilege_id" ref="privilege_next_accountant"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_next_manager" model="res.groups">
            <field name="name">Hotel Manager/Admin</field>
            <field name="privilege_id" ref="privilege_next_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_next_front_desk')),
                                              (4, ref('group_next_housekeeping_supervisor')),
                                              (4, ref('group_next_maintenance_supervisor')),
                                              (4, ref('group_next_accountant'))]"/>
        </record>

    </data>
</odoo>
