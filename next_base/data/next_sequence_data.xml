<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_next_reservation" model="ir.sequence">
            <field name="name">NEXT Reservation</field>
            <field name="code">next.reservation</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_next_folio" model="ir.sequence">
            <field name="name">NEXT Folio</field>
            <field name="code">next.folio</field>
            <field name="prefix">FOL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
