<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_next_property_dashboard_wizard_form" model="ir.ui.view">
        <field name="name">next.property.dashboard.wizard.form</field>
        <field name="model">next.property.dashboard.wizard</field>
        <field name="arch" type="xml">
            <!-- target="current" - a normal page/tab, not a popup, same as
                 the Executive 360 Dashboard. -->
            <form string="Property Manager Dashboard">
                <header>
                    <button name="action_compute" string="Refresh" type="object" class="btn-primary"/>
                    <button name="action_print_property_report" string="Print Property Report"
                            type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="property_id"/>
                        <field name="period_type"/>
                        <field name="anchor_date"/>
                    </group>
                    <field name="result_html"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_next_property_dashboard_wizard" model="ir.actions.act_window">
        <field name="name">Property Manager Dashboard</field>
        <field name="res_model">next.property.dashboard.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
